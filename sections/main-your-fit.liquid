      'Dress Shoes': 'Sneakers',
      'Golf Shoes': 'Golf',
      'Cycling Shoes': 'Cycling',
      'Soccer Cleats': 'Sneakers',
      Heels: 'Sneakers',
      'Ski Boots': 'Boots',
      'Ice Skates': 'Sneakers',
      'Ice Skates (Hockey)': 'Sneakers',
      'Basketball Shoes': 'Basketball',
    },
    arch_map: {
      'Flat Foot': 'Flat',
      'Flat Feet': 'Flat',
      'Normal Arch': 'Normal',
      'High Arch': 'High',
    },
  };

  class QuizResults extends HTMLElement {
    constructor() {
      super();
      this.defaultVariantId = 40606957371456;
      this.config = {
        redirectMode: this.shouldRedirect(),
        remapVariant: true,
        quizDataKey: 'quiz_data',
        quizTimestampKey: 'quiz_data_timestamp',
        quizVariantKey: 'quiz_variant',
        quizExpiryDays: null,
        shoeTypeVariants: {
          "Sneakers (Also known as 'Tennis Shoes')": this.defaultVariantId,
          'Running Shoes': this.defaultVariantId,
          'Pickleball Shoes': this.defaultVariantId,
          Boots: this.defaultVariantId,
          'Dress Shoes': this.defaultVariantId,
          'Golf Shoes': this.defaultVariantId,
          'Cycling Shoes': this.defaultVariantId,
          'Soccer Cleats': this.defaultVariantId,
          Heels: this.defaultVariantId,
          'Ski Boots': this.defaultVariantId,
          'Ice Skates': this.defaultVariantId,
          'Ice Skates (Hockey)': this.defaultVariantId,
          'Basketball Shoes': this.defaultVariantId,
        },
        conditionVariants: {
          None: this.defaultVariantId,
          'Flat Feet': this.defaultVariantId,
          'Plantar Fasciitis': this.defaultVariantId,
          Bunions: this.defaultVariantId,
          'Hammer Toes': this.defaultVariantId,
          "Morton's Neuroma": this.defaultVariantId,
          Arthritis: this.defaultVariantId,
          'Heel Spurs': this.defaultVariantId,
          'Limb-Length Discrepancy': this.defaultVariantId,
          Metatarsalgia: this.defaultVariantId,
          'Achilles Tendinitis': this.defaultVariantId,
          Sesamoiditis: this.defaultVariantId,
        },
      };
    }

    shouldRedirect() {
      if (window.Shopify && window.Shopify.designMode) return false;
      if (window.location.search.includes('preview_theme_id')) return false;
      if (window.parent !== window) return false;
      return true;
    }

    connectedCallback() {
      const params = new URLSearchParams(window.location.search);
      const hasQuizCompletion = params.get('quiz_complete') === 'true';

      if (hasQuizCompletion) {
        this.clearStoredQuizData();

        const urlQuizData = this.getLineItemProperties();
        const urlVariant = params.get('variant');
        if (urlVariant) this.storeVariant(this.cleanVariantId(urlVariant));

        if (Object.keys(urlQuizData).length === 0) {
          this.handleNoQuizData();
          return;
        }

        this.showContent();
        this.storeQuizData(urlQuizData);
        this.displayResults(urlQuizData);
        this.setupCartButton(urlQuizData);
        return;
      }

      this.handleNoQuizData();
    }

    showContent() {
      const successContent = this.querySelector('.quiz-results__success');
      if (successContent) successContent.style.display = 'block';
      const noDataContent = this.querySelector('.quiz-results__no-data');
      if (noDataContent) noDataContent.style.display = 'none';
    }

    disconnectedCallback() {}

    storeQuizData(quizData) {
      try {
        localStorage.setItem(this.config.quizDataKey, JSON.stringify(quizData));
        localStorage.setItem(this.config.quizTimestampKey, new Date().toISOString());
      } catch (error) {
        console.error('Failed to store quiz data:', error);
      }
    }

    storeVariant(variantId) {
      try {
        localStorage.setItem(this.config.quizVariantKey, variantId);
      } catch (error) {
        console.error('Failed to store quiz variant:', error);
      }
    }

    getStoredVariant() {
      try {
        return localStorage.getItem(this.config.quizVariantKey);
      } catch (error) {
        return null;
      }
    }

    getStoredQuizData() {
      try {
        if (this.isQuizDataExpired()) {
          this.clearStoredQuizData();
          return null;
        }
        const storedData = localStorage.getItem(this.config.quizDataKey);
        return storedData ? JSON.parse(storedData) : null;
      } catch (error) {
        return null;
      }
    }

    isQuizDataExpired() {
      if (!this.config.quizExpiryDays) return false;
      try {
        const timestamp = localStorage.getItem(this.config.quizTimestampKey);
        if (!timestamp) return true;
        const daysDiff = (new Date() - new Date(timestamp)) / (1000 * 60 * 60 * 24);
        return daysDiff > this.config.quizExpiryDays;
      } catch (error) {
        return true;
      }
    }

    clearStoredQuizData() {
      try {
        localStorage.removeItem(this.config.quizDataKey);
        localStorage.removeItem(this.config.quizTimestampKey);
        localStorage.removeItem(this.config.quizVariantKey);
      } catch (error) {
        console.error('Failed to clear quiz data:', error);
      }
    }

    setQuizDataExpiry(days) {
      this.config.quizExpiryDays = days;
    }

    getQuizDataForCart() {
      const quizData = this.getStoredQuizData();
      if (!quizData) return {};
      const shoeTypes = this.parseShoeTypes(quizData);
      return {
        lineItemProperties: this.formatAsLineItemProperties(quizData, shoeTypes),
        orderAttributes: this.formatAsOrderAttributes(quizData, shoeTypes),
      };
    }

    handleNoQuizData() {
      if (!this.config.redirectMode) return;
      const fallbackUrl = this.getAttribute('data-fallback-url') || '/pages/quiz';
      const successContent = this.querySelector('.quiz-results__success');
      const noDataContent = this.querySelector('.quiz-results__no-data');
      if (successContent) successContent.style.display = 'none';
      if (noDataContent) noDataContent.style.display = 'block';
      setTimeout(() => {
        window.location.href = fallbackUrl;
      }, 100);
    }

    // ─── JSON lookup ────────────────
    displayResults(lineItemProperties) {
      const profile = this.buildStrideProfile(lineItemProperties);
      if (profile) {
        const section = document.getElementById('stride-profile-section');
        if (section) section.style.display = 'block';
        this.renderStrideProfile(profile, lineItemProperties);
      }
    }

    // ─── Build profile from lookup table ─────────────────────
    buildStrideProfile(quizData) {
      const db = STRIDE_PROFILES;

      // Normalize condition — take first if multiple (e.g. "Hammer Toes, Bunions")
      const rawCondition = quizData['Condition'] || '';
      const condition = rawCondition.split(',')[0].trim() || 'None/Other';
      const conditionCard = db.cards.condition[condition] || db.cards.condition['None/Other'];

      // Normalize arch
      const rawArch = quizData['Arch'] || '';
      const archKey = db.arch_map[rawArch] || 'Normal';
      const archCard = db.cards.arch[archKey] || db.cards.arch['Normal'];

      // Normalize shoe
      const rawShoe = quizData['Shoe Type'] || '';
      const shoeKey = db.shoe_map[rawShoe] || 'Sneakers';
      const shoeCard = db.cards.shoe[shoeKey] || db.cards.shoe['Sneakers'];

      // Build headline from condition + shoe
      const headline = `${condition} Support for ${rawShoe || 'Your Footwear'}`;
      const subheadline = `Based on your arch type and activity, here's what your feet need.`;

      return {
        headline,
        subheadline,
        cta: 'Your insole match is ready and ships free.',
        cards: [conditionCard, archCard, shoeCard],
      };
    }

    setupCartButton(lineItemProperties) {
      // Target the CTA button rendered inside the stride profile
      // We defer lookup to after renderStrideProfile has run via a short timeout,
      // since the button lives inside #stride-profile-content which is populated by displayResults
      setTimeout(() => {
        const button = document.getElementById('stride-profile-cta-btn');
        if (!button) return;

        if (window.Shopify?.designMode) {
          button.addEventListener('click', (e) => {
            e.preventDefault();
            alert('This button adds personalized orthotics to cart in the live store.');
          });
          return;
        }

        button.addEventListener('click', (e) => {
          e.preventDefault();
          this.addToCart(lineItemProperties, button);
        });

        console.log('Cart button setup with quiz data:', lineItemProperties);
      }, 0);
    }

    async addToCart(lineItemProperties, button) {
      const originalText = button.querySelector('.btn-primary__text')?.textContent || window.variantStrings.addToCart;
      this.setButtonState(button, 'Adding...', true);

      try {
        let selectedVariantId;

        // STEP 1: Determine variant based on remapVariant mode
        if (this.config.remapVariant) {
          console.log('=== ADD TO CART: Legacy Mapping Mode ===');
          console.log('🎯 Config check - remapVariant:', this.config.remapVariant);
          console.log('🎯 Config check - defaultVariantId:', this.config.defaultVariantId);

          const conditions = this.parseConditions(lineItemProperties);
          const shoeTypes = this.parseShoeTypes(lineItemProperties);

          console.log('📋 Parsed conditions:', conditions);
          console.log('📋 Parsed shoe types:', shoeTypes);

          // Priority 1: condition variant
          if (conditions && conditions.length > 0) {
            const firstCondition = conditions[0];
            console.log('🔍 Checking condition:', firstCondition);
            const conditionVariant = this.getVariantForCondition(firstCondition);
            console.log('✅ Condition variant result:', conditionVariant);
            if (conditionVariant) {
              selectedVariantId = conditionVariant;
              console.log(`✅ Using condition-based variant for "${firstCondition}":`, selectedVariantId);
            } else {
              console.log(`⚠️ Condition "${firstCondition}" returned null, moving to shoe type...`);
            }
          } else {
            console.log('⚠️ No conditions found in quiz data');
          }

          // Priority 2: shoe type variant
          if (!selectedVariantId && shoeTypes && shoeTypes.length > 0) {
            const firstShoeType = shoeTypes[0];
            console.log('🔍 Checking shoe type:', firstShoeType);
            const shoeTypeVariant = this.getVariantForShoeType(firstShoeType);
            console.log('✅ Shoe type variant result:', shoeTypeVariant);
            if (shoeTypeVariant) {
              selectedVariantId = shoeTypeVariant;
              console.log(`✅ Using shoe type-based variant for "${firstShoeType}":`, selectedVariantId);
            } else {
              console.log(`⚠️ Shoe type "${firstShoeType}" returned null, moving to URL fallback...`);
            }
          } else {
            console.log('⚠️ No shoe types found or variant already selected');
          }

          // Priority 3: URL variant
          if (!selectedVariantId) {
            console.log('⚠️ No variant from mappings, checking URL...');
            const parts = window.location.href.split('?');
            const searchParams =
              parts.length > 2
                ? new URLSearchParams(parts.slice(1).join('&'))
                : new URLSearchParams(window.location.search);
            const urlVariant = searchParams.get('variant');
            console.log('🔍 URL variant found:', urlVariant);
            if (urlVariant) {
              selectedVariantId = this.cleanVariantId(urlVariant);
              console.log('✅ Using URL variant (cleaned):', selectedVariantId);
            }
          }

          // Priority 4: stored variant
          if (!selectedVariantId) {
            console.log('⚠️ No URL variant, checking localStorage...');
            const storedVariant = this.getStoredVariant();
            console.log('🔍 Stored variant found:', storedVariant);
            if (storedVariant) {
              selectedVariantId = this.cleanVariantId(storedVariant);
              console.log('✅ Using stored variant (cleaned):', selectedVariantId);
            }
          }

          // Priority 5: default fallback
          if (!selectedVariantId) {
            console.log('⚠️ No variant found anywhere, using default...');
            selectedVariantId = this.defaultVariantId;
            console.log('✅ Using default variant as final fallback:', selectedVariantId);
          }

          console.log('🎯 FINAL SELECTED VARIANT ID:', selectedVariantId);
        }

        // STEP 2: Format quiz data for cart
        const shoeTypes = this.parseShoeTypes(lineItemProperties);
        const lineItemPropertiesFormatted = this.formatAsLineItemProperties(lineItemProperties, shoeTypes);
        const orderAttributesFormatted = this.formatAsOrderAttributes(lineItemProperties, shoeTypes);

        console.log('=== ADD TO CART: Formatted Data ===');
        console.log('Line item properties:', lineItemPropertiesFormatted);
        console.log('Order attributes:', orderAttributesFormatted);

        // STEP 3: Clear the cart
        console.log('=== ADD TO CART: Clearing Cart ===');
        await this.clearCart();

        // STEP 4: Build and send cart request
        const cartData = {
          items: [{ id: selectedVariantId, quantity: 1, properties: lineItemPropertiesFormatted }],
          attributes: orderAttributesFormatted,
        };

        console.log('=== ADD TO CART: Final Cart Data ===');
        console.log('Cart data to add:', cartData);

        if (typeof publish === 'function') publish('cart:add:start', { items: cartData.items });

        const response = await fetch(`${window.shopUrl + window.routes.cart_add_url}.js`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(cartData),
        });

        console.log('=== ADD TO CART: Response ===');
        console.log('Response status:', response.status);

        const responseText = await response.text();
        console.log('Response text (first 200 chars):', responseText.substring(0, 200));

        let result;
        try {
          result = JSON.parse(responseText);
        } catch (parseError) {
          console.error('Failed to parse response as JSON:', parseError);
          throw new Error(`Server returned invalid response. Status: ${response.status}`);
        }

        if (!response.ok)
          throw new Error(result.description || result.message || `Cart add failed: ${response.status}`);

        console.log('Successfully added to cart:', result);

        this.setButtonState(button, 'Added! Redirecting...', true);
        if (typeof publish === 'function') publish('cart:add:success', { items: result.items || result });
        setTimeout(() => {
          window.location.href = window.routes.cart_url;
        }, 500);
      } catch (error) {
        console.error('=== ADD TO CART: Error ===');
        console.error('Error adding to cart:', error);
        if (typeof publish === 'function') publish('cart:add:error', { error: error.message });

        if (error.message.includes('sold out') || error.message.includes('already sold out')) {
          this.setButtonState(button, window.variantStrings.soldOut, true);
        } else if (error.message.includes("can't add more")) {
          this.setButtonState(button, window.cartStrings.quantityError.replace('[quantity]', '1'), true);
          setTimeout(() => {
            this.setButtonState(button, originalText, false);
          }, 3000);
        } else {
          this.setButtonState(button, 'Error - Try Again', false);
          setTimeout(() => {
            this.setButtonState(button, originalText, false);
          }, 2000);
        }
      }
    }

    async clearCart() {
      try {
        console.log('Clearing entire cart...');

        // Step 1: Clear all cart items
        const clearResponse = await fetch(`${window.shopUrl + window.routes.cart_clear_url}.js`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        if (!clearResponse.ok) throw new Error(`Failed to clear cart items: ${clearResponse.status}`);
        const clearResult = await clearResponse.json();
        console.log('Cart items cleared successfully:', clearResult);

        // Step 2: Clear order attributes
        const cartResponse = await fetch(`${window.shopUrl + window.routes.cart_url}.js`);
        const cart = await cartResponse.json();
        console.log('Current cart attributes after item clearing:', cart.attributes);

        if (cart.attributes && Object.keys(cart.attributes).length > 0) {
          console.log('Clearing remaining cart attributes...');
          const attributesToClear = {};
          Object.keys(cart.attributes).forEach((key) => {
            attributesToClear[key] = '';
          });
          console.log('Attributes to clear:', attributesToClear);

          const clearAttrsResponse = await fetch(`${window.shopUrl + window.routes.cart_update_url}.js`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attributes: attributesToClear }),
          });
          if (!clearAttrsResponse.ok) throw new Error(`Failed to clear cart attributes: ${clearAttrsResponse.status}`);
          const clearAttrsResult = await clearAttrsResponse.json();
          console.log('Cart attributes cleared successfully:', clearAttrsResult.attributes);
        } else {
          console.log('No cart attributes to clear');
        }

        console.log('Complete cart clearing finished successfully');
      } catch (error) {
        console.error('Error clearing cart:', error);
        // Don't throw — still proceed with adding new item
      }
    }

    getVariantForCondition(condition) {
      console.log('🔍 FULL CONDITION LOOKUP:');
      console.log('  Input condition:', JSON.stringify(condition));
      console.log('  Available mappings:', this.config.conditionVariants);
      console.log('  Direct lookup result:', this.config.conditionVariants[condition]);

      const variantId = this.config.conditionVariants[condition];
      if (!variantId) {
        console.warn(`⚠️ No variant mapping found for condition: "${condition}"`);
        console.log('Available conditions:', Object.keys(this.config.conditionVariants));
      }
      return variantId || null;
    }

    parseConditions(lineItemProperties) {
      const conditionValue = lineItemProperties['Condition'] || lineItemProperties['condition'];
      if (!conditionValue) return null;
      return conditionValue
        .split(',')
        .map((c) => c.trim())
        .filter((c) => c.length > 0);
    }

    getVariantForShoeType(shoeType) {
      const variantId = this.config.shoeTypeVariants[shoeType];
      console.log(`🔍 Looking up shoe type "${shoeType}":`, variantId);
      if (!variantId) {
        console.warn(`⚠️ No variant mapping found for shoe type: "${shoeType}"`);
        console.log('Available shoe types:', Object.keys(this.config.shoeTypeVariants));
      }
      return variantId || null;
    }

    cleanVariantId(variantId) {
      if (typeof variantId === 'string') return parseInt(variantId.split('?')[0].split('#')[0]);
      return variantId;
    }

    parseShoeTypes(lineItemProperties) {
      const shoeTypeValue = lineItemProperties['Shoe Type'] || lineItemProperties['shoe_type'];
      if (!shoeTypeValue) return null;
      return shoeTypeValue
        .split(',')
        .map((t) => t.trim())
        .filter((t) => t.length > 0);
    }

    formatAsLineItemProperties(lineItemProperties, shoeTypes = null) {
      const cartProperties = {};
      Object.keys(lineItemProperties).forEach((key) => {
        if (key === 'variant_id') return;
        let formattedKey = key.charAt(0).toUpperCase() + key.slice(1).replace(/_/g, ' ');
        if (key === 'Shoe Type') {
          cartProperties['Shoe Type'] = shoeTypes ? shoeTypes.join(', ') : lineItemProperties[key];
        } else {
          cartProperties[formattedKey] = lineItemProperties[key];
        }
      });
      return cartProperties;
    }

    formatAsOrderAttributes(lineItemProperties, shoeTypes = null) {
      const orderAttributes = {};
      Object.keys(lineItemProperties).forEach((key) => {
        if (key === 'variant_id') return;
        let value, formattedKey;
        if (key === 'Shoe Type') {
          value = shoeTypes ? shoeTypes.join(', ') : lineItemProperties[key];
          formattedKey = 'Shoe Type';
        } else {
          formattedKey = key.charAt(0).toUpperCase() + key.slice(1).replace(/_/g, ' ');
          value = lineItemProperties[key];
        }
        if (value && value.toString().trim() !== '') orderAttributes[formattedKey] = value;
      });
      return orderAttributes;
    }

    setButtonState(button, text, disabled) {
      if (!button) return;
      button.querySelectorAll('.btn-primary__text').forEach((el) => {
        el.textContent = text;
      });
      button.disabled = disabled;
      button.style.opacity = disabled ? '0.6' : '1';
      button.style.cursor = disabled ? 'not-allowed' : 'pointer';
    }

    getLineItemProperties() {
      let searchString = window.location.search;
      const parts = window.location.href.split('?');
      if (parts.length > 2) searchString = '?' + parts.slice(1).join('&');

      const params = new URLSearchParams(searchString);
      const data = {};

      const excludedParams = [
        'quiz_complete',
        'token',
        'variant',
        'storefront',
        'pairs',
        'checkout',
        'checkout_url',
        'debug',
        'quantity',
        '_ga',
        '_gid',
        'utm_source',
        'utm_medium',
        'utm_campaign',
        'utm_term',
        'utm_content',
        'fbclid',
        'gclid',
        'cart_link_id',
        'preview_theme_id',
        'pb',
      ];

      for (let [key, value] of params.entries()) {
        if (
          !excludedParams.includes(key) &&
          !key.startsWith('checkout[') &&
          !key.startsWith('utm_') &&
          !key.startsWith('_')
        ) {
          const decodedValue = decodeURIComponent(value);
          if (decodedValue && decodedValue.trim() !== '' && !/^_+(\s+_+)*$/.test(decodedValue.trim())) {
            data[key] = decodedValue;
          }
        }
      }

      return data;
    }

    // ─── Render ───────────────────────────────────────────────
    renderStrideProfile(data, quizData) {
      const headlineEl = document.getElementById('sp-headline');
      const subheadlineEl = document.getElementById('sp-subheadline');
      const ctaTextEl = document.getElementById('sp-cta-text');

      if (headlineEl) headlineEl.textContent = data.headline || '';
      if (subheadlineEl) subheadlineEl.textContent = data.subheadline || '';
      if (ctaTextEl) ctaTextEl.textContent = data.cta || '';

      // Render cards
      const cardsEl = document.getElementById('sp-cards');
      if (cardsEl && data.cards && data.cards.length) {
        cardsEl.innerHTML = data.cards
          .map(
            (card) => `
            <div class="stride-profile__card">
              <div class="stride-profile__card-icon">${card.emoji || '👟'}</div>
              <div class="stride-profile__card-body">
                <p class="stride-profile__card-label">${this.escapeHtml(card.label || '')}</p>
                <p class="stride-profile__card-title">${this.escapeHtml(card.title || '')}</p>
                <p class="stride-profile__card-desc">${this.escapeHtml(card.desc || '')}</p>
              </div>
            </div>
          `,
          )
          .join('');
      }

      // Render profile tags — injected from live quiz data
      const tagsEl = document.getElementById('sp-tags');
      if (tagsEl && quizData) {
        const tags = [
          quizData['Reason'] ? { label: 'Goal', value: quizData['Reason'] } : null,
          quizData['Condition'] ? { label: 'Condition', value: quizData['Condition'] } : null,
          quizData['Arch'] ? { label: 'Arch', value: quizData['Arch'] } : null,
          quizData['Size'] ? { label: 'Size', value: quizData['Size'] } : null,
          quizData['Pain Region (L)'] ? { label: 'Pain (L)', value: quizData['Pain Region (L)'] } : null,
          quizData['Pain Region (R)'] ? { label: 'Pain (R)', value: quizData['Pain Region (R)'] } : null,
          quizData['Pain Frequency'] ? { label: 'Frequency', value: quizData['Pain Frequency'] } : null,
          quizData['Shoe Type'] ? { label: 'Shoe', value: quizData['Shoe Type'] } : null,
        ].filter(Boolean);

        tagsEl.innerHTML = tags
          .map(
            (t) =>
              `<span class="stride-profile__tag"><strong>${this.escapeHtml(t.label)}:</strong> ${this.escapeHtml(t.value)}</span>`,
          )
          .join('');
      }
    }

    escapeHtml(str) {
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
  }

  window.QuizResults = QuizResults;
  window.customElements.define('quiz-results', QuizResults);

  window.getQuizData = function () {
    const el = document.querySelector('quiz-results');
    return el ? el.getStoredQuizData() : null;
  };

  window.getQuizDataForCart = function () {
    const el = document.querySelector('quiz-results');
    return el ? el.getQuizDataForCart() : {};
  };

  window.getQuizVariant = function () {
    const el = document.querySelector('quiz-results');
    return el ? el.getStoredVariant() : null;
  };

  window.setQuizVariant = function (variantId) {
    const el = document.querySelector('quiz-results');
    if (el) el.storeVariant(variantId);
  };

  window.clearQuizData = function () {
    const el = document.querySelector('quiz-results');
    if (el) el.clearStoredQuizData();
  };
{% endjavascript %}

