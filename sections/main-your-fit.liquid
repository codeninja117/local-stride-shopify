<style>
  body {
    background-color: #f2f2f2;
  }
  .timeline-steps::before {
    content: '';
    position: absolute;
    left: 0px;
    top: 3rem;
    bottom: 4rem;
    width: 2px;
    background-color: #9c876d;
    height: 0;
    z-index: 1;
    animation: drawLine 2s cubic-bezier(0.4, 0, 0.2, 1) 0.5s forwards;
  }

  .step-item span {
    z-index: 10;
  }

  .step-1 .step-item__content {
    opacity: 1;
  }

  .step-2 .step-item__content {
    animation: fadeInStep 0.6s ease 0.6s forwards;
  }

  .step-3 .step-item__content {
    animation: fadeInStep 0.6s ease 1.6s forwards;
  }

  @keyframes drawLine {
    0% {
      height: 0;
    }
    30% {
      height: 4rem;
    }
    60% {
      height: 8rem;
    }
    100% {
      height: calc(100% - 7rem);
    }
  }

  @keyframes fadeInStep {
    from {
      opacity: 0.3;
    }
    to {
      opacity: 1;
    }
  }

  /* ─── Stride Profile ─────────────────────────────────────── */

  .stride-profile {
    max-width: 640px;
    margin: 0 auto 3rem;
    text-align: left;
    padding-bottom: 80px;
  }

  .stride-profile__eyebrow {
    text-align: center;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: #9c876d;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .stride-profile__headline {
    text-align: center;
    font-size: 2rem;
    font-weight: 800;
    color: #1a1a1a;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }

  .stride-profile__subheadline {
    text-align: center;
    font-size: 1rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .stride-profile__divider {
    width: 2.5rem;
    height: 2px;
    background: #9c876d;
    margin: 0 auto 2rem;
  }

  .stride-profile__cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .stride-profile__card {
    background: #fff;
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid #9c876d;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .stride-profile__card-icon {
    font-size: 1.75rem;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f7f3ee;
    border-radius: 0.5rem;
    flex-shrink: 0;
  }

  .stride-profile__card-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9c876d;
    margin-bottom: 0.25rem;
  }

  .stride-profile__card-title {
    font-size: 1rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 0.4rem;
  }

  .stride-profile__card-desc {
    font-size: 0.875rem;
    color: #555;
    line-height: 1.6;
  }

  .stride-profile__glance {
    background: #1a1a1a;
    border-radius: 1rem;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .stride-profile__glance-label {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9c876d;
    margin-bottom: 0.75rem;
  }

  .stride-profile__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stride-profile__tag {
    background: #2a2a2a;
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.8rem;
    color: #e0d8cf;
  }

  .stride-profile__tag strong {
    color: #fff;
  }

  .stride-profile__cta-sub {
    font-size: 0.8rem;
    color: #999;
    margin-top: 0.75rem;
    text-align: center;
  }

  .stride-profile__cta-group {
    max-width: 100%;
    margin: 0 auto;
    text-align: center;
    z-index: 99999999;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    border-radius: 1rem;
    background: #fff;
    padding: 1.25rem 1.5rem;
    position: fixed;
    bottom: 0;
    left: 0.5rem;
    right: 0.5rem;

    @media (min-width: 768px) {
      left: 1rem;
      right: 1rem;
      width: 768px;
    }
  }

  #stride-profile-cta-btn {
    max-width: 100%;
  }
</style>

<div class="page-width py-8">
  <quiz-results data-fallback-url="{{ section.settings.fallback_redirect_url | default: '/pages/quiz' }}">
    <div class="quiz-results__success">
      <div class="quiz-results__success-content text-center">
        <!-- ─── Stride Profile Section ──────────────────────────── -->
        <div id="stride-profile-section" class="stride-profile" style="display:none;">
          <!-- Real content injected by JS -->
          <div id="stride-profile-content">
            <p class="stride-profile__eyebrow">Your Stride Profile</p>
            <h2 class="stride-profile__headline" id="sp-headline"></h2>
            <p class="stride-profile__subheadline" id="sp-subheadline"></p>
            <div class="stride-profile__divider"></div>

            <div class="stride-profile__cards" id="sp-cards"></div>

            <div class="stride-profile__glance">
              <p class="stride-profile__glance-label">Your Profile at a Glance</p>
              <div class="stride-profile__tags" id="sp-tags"></div>
            </div>

            <div class="stride-profile__cta-group">
              <p style="font-size:0.9rem;color:#555;margin-bottom:1rem;text-align:center;" id="sp-cta-text"></p>

              <button
                id="stride-profile-cta-btn"
                type="button"
                class="btn-primary text-xl font-semibold"
              >
                <div class="btn-primary__inner">
                  <div class="btn-primary__text-wrapper">
                    <div class="btn-primary__text">Get My Strides →</div>
                    <div class="btn-primary__text">Get My Strides →</div>
                  </div>
                </div>
              </button>
            </div>
          </div>
        </div>
        <!-- ─── End Stride Profile ──────────────────────────────── -->
      </div>
    </div>

    <!-- Blank fallback content (hidden by default) -->
    <div class="quiz-results__no-data" style="display: none;">
      <div class="min-h-screen"></div>
    </div>
  </quiz-results>
</div>

{% javascript %}
