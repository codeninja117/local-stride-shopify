{% comment %} ss-about.liquid {% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --color-background: {{ section.settings.color_scheme.settings.background.red }}, {{ section.settings.color_scheme.settings.background.green }}, {{ section.settings.color_scheme.settings.background.blue }};
    --color-foreground: {{ section.settings.color_scheme.settings.text.red }}, {{ section.settings.color_scheme.settings.text.green }}, {{ section.settings.color_scheme.settings.text.blue }};
    --color-foreground-muted: {{ section.settings.color_scheme.settings.text_muted.red }}, {{ section.settings.color_scheme.settings.text_muted.green }}, {{ section.settings.color_scheme.settings.text_muted.blue }};
    --color-accent: {{ section.settings.color_scheme.settings.accent_color.red }}, {{ section.settings.color_scheme.settings.accent_color.green }}, {{ section.settings.color_scheme.settings.accent_color.blue }};
    background: rgb(var(--color-background));
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} .legacy-photo-wrap::before {
    background: rgb(var(--color-accent));
  }

  #shopify-section-{{ section.id }} .legacy-name-tag {
    border-left-color: rgb(var(--color-accent));
  }

  #shopify-section-{{ section.id }} .legacy-name-label {
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .legacy-name-sub {
    color: rgba(var(--color-foreground-muted));
  }

  #shopify-section-{{ section.id }} .legacy-caption {
    color: rgba(var(--color-foreground-muted));
  }

  #shopify-section-{{ section.id }} .legacy-stats {
    border-top-color: rgba(var(--color-accent), 0.25);
  }

  #shopify-section-{{ section.id }} .legacy-stat-number {
    color: rgb(var(--color-foreground));
  }

  #shopify-section-{{ section.id }} .legacy-stat-label {
    color: rgba(var(--color-foreground-muted));
  }

  #shopify-section-{{ section.id }} .legacy-link {
    color: rgb(var(--color-foreground));
    border-bottom-color: rgb(var(--color-accent));
  }

  #shopify-section-{{ section.id }} .ss-body h1 {
    display: inline;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .ss-body p {
    display: inline;
  }
{%- endstyle -%}

{%- liquid
  assign has_video = false
  if section.settings.video != null or section.settings.video_url != null
    assign has_video = true
  endif
  assign about_video_id = section.settings.video.id | default: section.settings.video_url.id
-%}

<section
  class="ss-about page-width"
  id="shopify-section-{{ section.id }}"
  data-animate="fade-up"
>
  <!-- LEFT -->
  <div class="legacy-photo-wrap{% if has_video %} legacy-photo-wrap--has-video{% endif %}" data-cascade="0.05">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1200
        | image_tag: class: 'legacy-photo', loading: 'lazy', widths: '400, 600, 800, 1000, 1200'
      }}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'legacy-photo legacy-photo--placeholder' }}
    {%- endif -%}

    {%- if has_video -%}
      <modal-opener data-modal="#AboutVideoModal-{{ section.id }}" class="legacy-play-btn-wrap">
        <button
          class="legacy-play-btn"
          type="button"
          aria-label="Play video"
        >
          <span class="legacy-play-btn__inner">
            <svg viewBox="0 0 24 24" class="legacy-play-btn__icon">
              <polygon points="5,3 19,12 5,21"/>
            </svg>
          </span>
        </button>
      </modal-opener>

      <modal-dialog
        id="AboutVideoModal-{{ section.id }}"
        class="invisible fixed inset-0 z-101 flex items-center justify-center overflow-hidden overflow-y-auto bg-black/30 opacity-0 backdrop-blur-lg transition-opacity duration-300 ease-in-out [&[open]]:visible [&[open]]:opacity-100"
        data-play-on-open
      >
        <div
          role="dialog"
          aria-label="{{ shop.name }} video"
          aria-modal="true"
          class="w-[768px] max-w-full"
          tabindex="-1"
        >
          <button
            id="ModalClose-About-{{ section.id }}"
            type="button"
            class="absolute top-4 right-4 text-white"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="48"
              height="48"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
            </svg>
          </button>

          {%- if section.settings.video != null -%}
            {%- assign video_alt = section.settings.video.alt | default: shop.name -%}
            {{
              section.settings.video
              | video_tag: class: 'h-auto w-full', controls: true, autoplay: false, muted: false, alt: video_alt
            }}
          {%- elsif section.settings.video_url != null -%}
            {%- if section.settings.video_url.type == 'youtube' -%}
              <iframe
                src="https://www.youtube.com/embed/{{ about_video_id }}?enablejsapi=1"
                class="js-youtube aspect-video w-full"
                allow="autoplay; encrypted-media"
                allowfullscreen
                title="{{ shop.name }} video"
              ></iframe>
            {%- else -%}
              <iframe
                src="https://player.vimeo.com/video/{{ about_video_id }}"
                class="js-vimeo aspect-video w-full"
                allow="autoplay; encrypted-media"
                allowfullscreen
                title="{{ shop.name }} video"
              ></iframe>
            {%- endif -%}
          {%- endif -%}
        </div>
      </modal-dialog>
    {%- endif -%}

    {%- if section.settings.image_caption != blank -%}
      <p class="legacy-caption">{{ section.settings.image_caption }}</p>
    {%- endif -%}

    <div class="legacy-names">
      {% for block in section.blocks %}
        {% if block.type == 'name_tag' %}
          <div class="legacy-name-tag" {{ block.shopify_attributes }}>
            <div class="legacy-name-label">{{ block.settings.name }}</div>
            <div class="legacy-name-sub">{{ block.settings.title }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <!-- RIGHT -->
  <div class="legacy-text" data-animate>
    {%- if section.settings.eyebrow != blank -%}
      <div class="ss-eyebrow" data-cascade="0.05">{{ section.settings.eyebrow }}</div>
    {%- endif -%}

    {%- if section.settings.heading_line1 != blank or section.settings.heading_line2 != blank -%}
      <h2 class="ss-heading" data-cascade="0.10">
        {{ section.settings.heading_line1 }}
        {%- if section.settings.heading_line1 != blank and section.settings.heading_line2 != blank -%}<br>{% endif %}
        {{ section.settings.heading_line2 }}
      </h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="ss-body" data-cascade="0.15">
        {{ section.settings.body }}
      </div>
    {%- endif -%}

    <div class="legacy-stats" data-cascade="0.20">
      {% for block in section.blocks %}
        {% if block.type == 'stat' %}
          <div class="legacy-stat" {{ block.shopify_attributes }}>
            <div class="legacy-stat-number">{{ block.settings.number }}</div>
            <div class="legacy-stat-label">{{ block.settings.label }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
      <a href="{{ section.settings.link_url }}" class="legacy-link" data-cascade="0.25">
        {{ section.settings.link_label }} &rarr;
      </a>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .ss-about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .legacy-photo-wrap {
    position: relative;
  }

  #shopify-section-{{ section.id }} .legacy-photo-wrap::before {
    content: '';
    position: absolute;
    top: -16px;
    left: -16px;
    width: 80px;
    height: 4px;
    border-radius: 2px;
  }

  #shopify-section-{{ section.id }} .legacy-photo {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    object-position: center top;
    border-radius: 12px;
    display: block;
    filter: saturate(0.9);
  }

  #shopify-section-{{ section.id }} .legacy-photo--placeholder {
    width: 100%;
    aspect-ratio: 4/3;
    border-radius: 12px;
    display: block;
    background: rgba(var(--color-accent), 0.15);
  }

  /* Subtle dark overlay on image when video is present */
  #shopify-section-{{ section.id }} .legacy-photo-wrap--has-video .legacy-photo {
    filter: saturate(0.9) brightness(0.85);
    transition: filter 0.3s ease;
  }

  #shopify-section-{{ section.id }} .legacy-photo-wrap--has-video:hover .legacy-photo {
    filter: saturate(0.9) brightness(0.75);
  }

  /* Play button — centered over image */
  #shopify-section-{{ section.id }} .legacy-play-btn-wrap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    /* stop above caption/names — image is aspect-ratio 4/3 so use padding trick */
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    /* only cover the image, not the caption below */
    height: calc(100% / (1 + (100% - 100%) * 0));
  }

  /* Simpler: position relative to image via absolute on the wrap,
     but constrain height to the image aspect ratio */
  #shopify-section-{{ section.id }} .legacy-play-btn-wrap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: auto;
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .legacy-play-btn {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  #shopify-section-{{ section.id }} .legacy-play-btn:hover {
    transform: scale(1.08);
    background: rgba(255, 255, 255, 0.3);
  }

  #shopify-section-{{ section.id }} .legacy-play-btn__inner {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  #shopify-section-{{ section.id }} .legacy-play-btn__icon {
    width: 18px;
    height: 18px;
    fill: #111;
    margin-left: 3px;
  }

  #shopify-section-{{ section.id }} .legacy-caption {
    margin-top: 12px;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .legacy-names {
    display: flex;
    gap: 24px;
    margin-top: 14px;
  }

  #shopify-section-{{ section.id }} .legacy-name-tag {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    padding-left: 10px;
    border-left: 2px solid;
  }

  #shopify-section-{{ section.id }} .legacy-name-label {
    font-size: 13px;
    font-weight: 700;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .legacy-name-sub {
    font-size: 11px;
    font-weight: 400;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .legacy-text {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  #shopify-section-{{ section.id }} .legacy-stats {
    display: flex;
    gap: 40px;
    padding-top: 8px;
    border-top: 1px solid;
  }

  #shopify-section-{{ section.id }} .legacy-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #shopify-section-{{ section.id }} .legacy-stat-number {
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .legacy-stat-label {
    font-size: 12px;
    font-weight: 400;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .legacy-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.01em;
    border-bottom: 1.5px solid;
    padding-bottom: 2px;
    width: fit-content;
    transition: opacity 0.2s;
  }

  #shopify-section-{{ section.id }} .legacy-link:hover {
    opacity: 0.7;
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .ss-about {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>

{% schema %}
{
  "name": "SS About",
  "tag": "section",
  "class": "ss-about-section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "inline_richtext",
      "id": "image_caption",
      "label": "Caption",
      "default": "Dietmar & Dominik Walter, Oberkochen"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (Shopify-hosted)",
      "info": "Adds a play button over the photo. Leave blank to show photo only."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Made in Germany"
    },
    {
      "type": "inline_richtext",
      "id": "heading_line1",
      "label": "Heading line 1",
      "default": "70 years of podiatry."
    },
    {
      "type": "inline_richtext",
      "id": "heading_line2",
      "label": "Heading line 2",
      "default": "Now at <em>your door.</em>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Every Stride orthotic is designed in Oberkochen, Germany by <strong>Dietmar Walter<\/strong> and his third-generation clinic — the same team top hospitals and physical therapists around the world trust to prescribe orthotics to their own patients.<\/p>",
      "info": "Line breaks won't work for h1 tag functionality."
    },
    {
      "type": "header",
      "content": "Link"
    },
    {
      "type": "inline_richtext",
      "id": "link_label",
      "label": "Link label",
      "default": "Learn the full story"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "name_tag",
      "name": "Name Tag",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "name",
          "label": "Name",
          "default": "Dietmar Walter"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Orthopaedic Innovator & Seifriz Award Winner"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "number",
          "label": "Number / Value",
          "default": "Est. 1995"
        },
        {
          "type": "inline_richtext",
          "id": "label",
          "label": "Label",
          "default": "Dr. Walter's clinic, Oberkochen Germany"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SS About",
      "blocks": [
        {
          "type": "name_tag",
          "settings": {
            "name": "Dietmar Walter",
            "title": "Orthopaedic Innovator & Seifriz Award Winner"
          }
        },
        {
          "type": "name_tag",
          "settings": {
            "name": "Dominik Walter",
            "title": "Clinical Operations, Oberkochen"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "Est. 1995",
            "label": "Dr. Walter's clinic, Oberkochen Germany"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "60+",
            "label": "Countries using Dr. Walter's systems"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "Seifriz Award",
            "label": "Adalbert Seifriz Award for innovation, 2000"
          }
        }
      ]
    }
  ]
}
{% endschema %}
