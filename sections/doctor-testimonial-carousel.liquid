{% comment %} ss-doctor-carousel.liquid {% endcomment %}

{%- style -%}
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} .doctor-testimonial-carousel {
    {%- if section.settings.background_color != blank -%}
      background-color: {{ section.settings.background_color }};
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} cite {
    font-style: normal;
  }

  #shopify-section-{{ section.id }} .doctor-testimonial-carousel__testimonial {
    transform: translate(15%, -15%);
  }

  #shopify-section-{{ section.id }} .text-h1 {
    font-weight: 300;
  }

  #shopify-section-{{ section.id }} .text-h1 strong {
    font-weight: 500;
  }

  #shopify-section-{{ section.id }} blockquote {
    color: #525A63;
  }

  #shopify-section-{{ section.id }} cite {
    font-weight: 700;
    color: #000000;
  }

  #shopify-section-{{ section.id }} .flex.flex-col p:last-child {
    color: #67717B;
  }

  @media screen and (min-width: 1024px) {
    .lg\:mb-12 {
      margin-bottom: calc(var(--spacing) * 12);
    }
  }

  .section-{{ section.id }}-main {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-main {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── Play button ──────────────────────────────────────── */
  #shopify-section-{{ section.id }} .ss-play-btn-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 10;
  }

  #shopify-section-{{ section.id }} .ss-play-btn-wrap.is-hidden {
    display: none;
  }

  #shopify-section-{{ section.id }} .ss-play-btn {
    pointer-events: all;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  #shopify-section-{{ section.id }} .ss-play-btn:hover {
    transform: scale(1.08);
    background: rgba(255, 255, 255, 0.3);
  }

  #shopify-section-{{ section.id }} .ss-play-btn__inner {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  #shopify-section-{{ section.id }} .ss-play-btn__icon {
    width: 16px;
    height: 16px;
    fill: #111;
    margin-left: 3px;
  }

  /* Dim image when it has an active play button over it */
  #shopify-section-{{ section.id }} .doctor-frame--has-btn .doctor-image:not(.opacity-0),
  #shopify-section-{{ section.id }} .doctor-frame--has-btn .doctor-image-mobile:not(.opacity-0) {
    filter: brightness(0.82);
    transition: filter 0.3s ease;
  }
{%- endstyle -%}

{%- comment -%} Build a map of block index → has_video for JS data attributes {%- endcomment -%}
{%- liquid
  assign video_display = section.settings.video_button_display
-%}

{%- comment -%} Render all modals once, outside carousel markup {%- endcomment -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'doctor' and block.settings.video != null -%}
    <modal-dialog
      id="DoctorVideoModal-{{ section.id }}-{{ forloop.index0 }}"
      class="invisible fixed inset-0 z-101 flex items-center justify-center overflow-hidden overflow-y-auto bg-black/30 opacity-0 backdrop-blur-lg transition-opacity duration-300 ease-in-out [&[open]]:visible [&[open]]:opacity-100"
      data-play-on-open
    >
      <div
        role="dialog"
        aria-label="{{ block.settings.name | default: shop.name }} video"
        aria-modal="true"
        class="w-[768px] max-w-full"
        tabindex="-1"
      >
        <button
          id="ModalClose-DoctorVideo-{{ section.id }}-{{ forloop.index0 }}"
          type="button"
          class="absolute top-4 right-4 text-white"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="48"
            height="48"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </button>
        {%- assign video_alt = block.settings.video.alt | default: block.settings.name | default: shop.name -%}
        {{
          block.settings.video
          | video_tag: class: 'h-auto w-full', controls: true, autoplay: false, muted: false, alt: video_alt
        }}
      </div>
    </modal-dialog>
  {%- endif -%}
{%- endfor -%}

<div class="doctor-testimonial-carousel section-{{ section.id }}-main gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- comment -%} Section title {%- endcomment -%}
    {%- if section.settings.title != blank -%}
      <div class="mb-6 pb-2 text-center lg:mb-12">
        <div class="text-h1 text-black">{{ section.settings.title }}</div>
      </div>
    {%- endif -%}

    <div class="flex flex-col gap-1 lg:flex-row lg:gap-1">
      {%- comment -%} ── MOBILE ──────────────────────────────────────────── {%- endcomment -%}
      <div class="block lg:hidden">
        <div class="doctor-testimonial-carousel__images-mobile mb-6">
          <div class="relative">
            <div
              class="doctor-frame doctor-frame-mobile relative overflow-hidden rounded-lg"
              style="aspect-ratio: 333/459;"
            >
              {%- for block in section.blocks -%}
                {%- if block.type == 'doctor' -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 400 }}"
                    alt="{{ block.settings.name | escape }}"
                    class="doctor-image-mobile absolute inset-0 h-full w-full object-cover transition-opacity duration-500 ease-in-out {% unless forloop.first %}opacity-0{% endunless %}"
                    data-index="{{ forloop.index0 }}"
                    loading="lazy"
                    width="400"
                    height="400"
                  >
                {%- endif -%}
              {%- endfor -%}

              {%- comment -%} Mobile play button — shown/hidden by JS {%- endcomment -%}
              <modal-opener
                data-modal="#DoctorVideoModal-{{ section.id }}-__IDX__"
                class="ss-play-btn-wrap is-hidden"
                id="PlayBtnMobile-{{ section.id }}"
              >
                <button class="ss-play-btn" type="button" aria-label="Play video">
                  <span class="ss-play-btn__inner">
                    <svg viewBox="0 0 24 24" class="ss-play-btn__icon">
                      <polygon points="5,3 19,12 5,21"/>
                    </svg>
                  </span>
                </button>
              </modal-opener>

              <div class="absolute right-0 bottom-0 z-10 flex">
                <button
                  class="doctor-carousel-prev-mobile flex h-12 w-12 items-center justify-center shadow-sm transition-colors hover:opacity-80"
                  style="background-color: #EACBA4;"
                  aria-label="Previous doctor"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="19" height="14" viewBox="0 0 19 14" fill="none">
                    <path d="M17.2803 6.78019L1.4012 6.78019M1.4012 6.78019L7.3559 0.825524M1.4012 6.78019L7.3559 12.7349" stroke="black" stroke-width="1.48867" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
                <button
                  class="doctor-carousel-next-mobile ml-1 flex h-12 w-12 items-center justify-center shadow-sm transition-colors hover:opacity-80"
                  style="background-color: #EACBA4;"
                  aria-label="Next doctor"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="19" height="14" viewBox="0 0 19 14" fill="none">
                    <path d="M1.7197 6.78019L17.5988 6.78019M17.5988 6.78019L11.6441 0.825524M17.5988 6.78019L11.6441 12.7349" stroke="black" stroke-width="1.48867" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>

        <div class="doctor-testimonial-carousel__content-mobile">
          <div class="doctor-testimonial-carousel__testimonial-mobile relative overflow-hidden rounded-xl bg-white p-6">
            <div class="testimonial-content" id="testimonial-content-mobile-{{ section.id }}">
              {%- for block in section.blocks -%}
                {%- if block.type == 'doctor' -%}
                  <div
                    class="testimonial-item-mobile {% unless forloop.first %}hidden{% endunless %}"
                    data-index="{{ forloop.index0 }}"
                    data-has-video="{% if block.settings.video != null %}true{% else %}false{% endif %}"
                    data-modal-id="DoctorVideoModal-{{ section.id }}-{{ forloop.index0 }}"
                    {{ block.shopify_attributes }}
                  >
                    {%- if block.settings.quote != blank -%}
                      <blockquote class="text-body-m mb-8 text-gray-700">"{{ block.settings.quote }}"</blockquote>
                    {%- endif -%}
                    <div class="flex flex-col">
                      {%- if block.settings.name != blank -%}
                        <cite class="text-h3 mb-2 font-bold text-gray-900 md:mb-1">{{ block.settings.name }}</cite>
                      {%- endif -%}
                      {%- if block.settings.position != blank -%}
                        <p class="text-body-m text-gray-600">{{ block.settings.position }}</p>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>

      {%- comment -%} ── DESKTOP ─────────────────────────────────────────── {%- endcomment -%}
      <div class="hidden w-full flex-col gap-1 lg:flex lg:flex-row lg:gap-1">
        {%- comment -%} Left: testimonial card {%- endcomment -%}
        <div class="relative z-10 flex w-1/4 flex-col justify-center">
          <div class="doctor-testimonial-carousel__content">
            <div class="doctor-testimonial-carousel__testimonial relative overflow-hidden rounded-xl bg-white p-6">
              <div class="testimonial-content" id="testimonial-content-{{ section.id }}">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'doctor' -%}
                    <div
                      class="testimonial-item {% unless forloop.first %}hidden{% endunless %}"
                      data-index="{{ forloop.index0 }}"
                      data-has-video="{% if block.settings.video != null %}true{% else %}false{% endif %}"
                      data-modal-id="DoctorVideoModal-{{ section.id }}-{{ forloop.index0 }}"
                      {{ block.shopify_attributes }}
                    >
                      {%- if block.settings.quote != blank -%}
                        <blockquote class="text-body-m mb-8 text-gray-700">"{{ block.settings.quote }}"</blockquote>
                      {%- endif -%}
                      <div class="flex flex-col">
                        {%- if block.settings.name != blank -%}
                          <cite class="text-h3 mb-2 font-bold text-gray-900">{{ block.settings.name }}</cite>
                        {%- endif -%}
                        {%- if block.settings.position != blank -%}
                          <p class="text-body-m text-gray-600">{{ block.settings.position }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        </div>

        {%- comment -%} Right: image frames {%- endcomment -%}
        <div class="relative z-0 flex w-3/4 flex-col justify-center">
          <div class="doctor-testimonial-carousel__images">
            <div class="relative">
              <div class="flex gap-4">
                {%- comment -%} Frame 1 — large, active slide {%- endcomment -%}
                <div class="doctor-frame doctor-frame-1 relative flex-shrink-0" style="width: 40%;">
                  <div class="relative overflow-hidden" style="aspect-ratio: 333/459;">
                    {%- for block in section.blocks -%}
                      {%- if block.type == 'doctor' -%}
                        <img
                          src="{{ block.settings.image | image_url: width: 400 }}"
                          alt="{{ block.settings.name | escape }}"
                          class="doctor-image absolute inset-0 h-full w-full object-cover transition-opacity duration-500 ease-in-out {% unless forloop.first %}opacity-0{% endunless %}"
                          data-index="{{ forloop.index0 }}"
                          data-frame="1"
                          loading="lazy"
                          width="400"
                          height="400"
                        >
                      {%- endif -%}
                    {%- endfor -%}

                    {%- comment -%} Frame 1 play button — active mode always uses this; all mode also uses this {%- endcomment -%}
                    <modal-opener
                      data-modal="#DoctorVideoModal-{{ section.id }}-__IDX__"
                      class="ss-play-btn-wrap is-hidden"
                      id="PlayBtnFrame1-{{ section.id }}"
                    >
                      <button class="ss-play-btn" type="button" aria-label="Play video">
                        <span class="ss-play-btn__inner">
                          <svg viewBox="0 0 24 24" class="ss-play-btn__icon">
                            <polygon points="5,3 19,12 5,21"/>
                          </svg>
                        </span>
                      </button>
                    </modal-opener>
                  </div>
                </div>

                {%- comment -%} Frame 2 — center {%- endcomment -%}
                <div class="doctor-frame doctor-frame-2 relative flex-shrink-0" style="width: 30%;">
                  <div class="relative overflow-hidden" style="aspect-ratio: 290/350;">
                    {%- for block in section.blocks -%}
                      {%- if block.type == 'doctor' -%}
                        <img
                          src="{{ block.settings.image | image_url: width: 400 }}"
                          alt="{{ block.settings.name | escape }}"
                          class="doctor-image absolute inset-0 h-full w-full object-cover transition-opacity duration-500 ease-in-out {% unless forloop.index == 2 %}opacity-0{% endunless %}"
                          data-index="{{ forloop.index0 }}"
                          data-frame="2"
                          loading="lazy"
                          width="400"
                          height="400"
                        >
                      {%- endif -%}
                    {%- endfor -%}

                    {%- comment -%} Frame 2 play button — only used in "all" mode {%- endcomment -%}
                    <modal-opener
                      data-modal="#DoctorVideoModal-{{ section.id }}-__IDX__"
                      class="ss-play-btn-wrap is-hidden"
                      id="PlayBtnFrame2-{{ section.id }}"
                    >
                      <button class="ss-play-btn" type="button" aria-label="Play video">
                        <span class="ss-play-btn__inner">
                          <svg viewBox="0 0 24 24" class="ss-play-btn__icon">
                            <polygon points="5,3 19,12 5,21"/>
                          </svg>
                        </span>
                      </button>
                    </modal-opener>

                    <div class="absolute bottom-0 left-0 z-10 flex">
                      <button
                        class="doctor-carousel-prev flex h-12 w-12 items-center justify-center shadow-sm transition-colors hover:opacity-80"
                        style="background-color: #EACBA4;"
                        aria-label="Previous doctor"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="14" viewBox="0 0 19 14" fill="none">
                          <path d="M17.2803 6.78019L1.4012 6.78019M1.4012 6.78019L7.3559 0.825524M1.4012 6.78019L7.3559 12.7349" stroke="black" stroke-width="1.48867" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                      <button
                        class="doctor-carousel-next ml-1 flex h-12 w-12 items-center justify-center shadow-sm transition-colors hover:opacity-80"
                        style="background-color: #EACBA4;"
                        aria-label="Next doctor"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="14" viewBox="0 0 19 14" fill="none">
                          <path d="M1.7197 6.78019L17.5988 6.78019M17.5988 6.78019L11.6441 0.825524M17.5988 6.78019L11.6441 12.7349" stroke="black" stroke-width="1.48867" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                    </div>
                  </div>
                </div>

                {%- comment -%} Frame 3 — right {%- endcomment -%}
                <div class="doctor-frame doctor-frame-3 relative flex-shrink-0" style="width: 30%;">
                  <div class="relative overflow-hidden rounded-lg" style="aspect-ratio: 290/350;">
                    {%- for block in section.blocks -%}
                      {%- if block.type == 'doctor' -%}
                        <img
                          src="{{ block.settings.image | image_url: width: 400 }}"
                          alt="{{ block.settings.name | escape }}"
                          class="doctor-image absolute inset-0 h-full w-full object-cover transition-opacity duration-500 ease-in-out {% unless forloop.index == 3 %}opacity-0{% endunless %}"
                          data-index="{{ forloop.index0 }}"
                          data-frame="3"
                          loading="lazy"
                          width="400"
                          height="400"
                        >
                      {%- endif -%}
                    {%- endfor -%}

                    {%- comment -%} Frame 3 play button — only used in "all" mode {%- endcomment -%}
                    <modal-opener
                      data-modal="#DoctorVideoModal-{{ section.id }}-__IDX__"
                      class="ss-play-btn-wrap is-hidden"
                      id="PlayBtnFrame3-{{ section.id }}"
                    >
                      <button class="ss-play-btn" type="button" aria-label="Play video">
                        <span class="ss-play-btn__inner">
                          <svg viewBox="0 0 24 24" class="ss-play-btn__icon">
                            <polygon points="5,3 19,12 5,21"/>
                          </svg>
                        </span>
                      </button>
                    </modal-opener>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} Section footer {%- endcomment -%}
    {%- if section.settings.button_label != blank -%}
      <div class="section__footer flex flex-col items-center gap-3 lg:mt-12">
        {%- render 'button',
          tag: 'a',
          text: section.settings.button_label,
          url: section.settings.button_url,
          variant: 'primary'
        -%}
        <span>{{ section.settings.disclaimer }}</span>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    const sectionEl = document.querySelector('#shopify-section-{{ section.id }}');
    if (!sectionEl) return;

    const VIDEO_DISPLAY = '{{ section.settings.video_button_display }}';
    const SECTION_ID = '{{ section.id }}';

    // ── Data ───────────────────────────────────────────────
    // Build block video map from testimonial-item data attributes
    // [ { hasVideo: bool, modalId: string }, ... ]
    const blockData = Array.from(sectionEl.querySelectorAll('.testimonial-item, .testimonial-item-mobile')).reduce(
      (acc, el) => {
        const idx = parseInt(el.dataset.index);
        if (!acc[idx]) {
          acc[idx] = {
            hasVideo: el.dataset.hasVideo === 'true',
            modalId: el.dataset.modalId || '',
          };
        }
        return acc;
      },
      {},
    );

    const totalItems = Object.keys(blockData).length;
    let currentIndex = 0;

    // ── Element refs ───────────────────────────────────────
    const testimonialItems = sectionEl.querySelectorAll('.testimonial-item');
    const testimonialItemsMobile = sectionEl.querySelectorAll('.testimonial-item-mobile');
    const doctorImages = sectionEl.querySelectorAll('.doctor-image');
    const doctorImagesMobile = sectionEl.querySelectorAll('.doctor-image-mobile');

    const prevBtn = sectionEl.querySelector('.doctor-carousel-prev');
    const nextBtn = sectionEl.querySelector('.doctor-carousel-next');
    const prevBtnMobile = sectionEl.querySelector('.doctor-carousel-prev-mobile');
    const nextBtnMobile = sectionEl.querySelector('.doctor-carousel-next-mobile');

    // Play button wrappers keyed by slot
    const playBtns = {
      frame1: sectionEl.querySelector('#PlayBtnFrame1-' + SECTION_ID),
      frame2: sectionEl.querySelector('#PlayBtnFrame2-' + SECTION_ID),
      frame3: sectionEl.querySelector('#PlayBtnFrame3-' + SECTION_ID),
      mobile: sectionEl.querySelector('#PlayBtnMobile-' + SECTION_ID),
    };

    // ── Helpers ────────────────────────────────────────────
    function setPlayBtn(btnWrap, blockIdx) {
      if (!btnWrap) return;
      const data = blockData[blockIdx];
      if (data && data.hasVideo) {
        btnWrap.setAttribute('data-modal', '#' + data.modalId);
        btnWrap.classList.remove('is-hidden');
      } else {
        btnWrap.classList.add('is-hidden');
      }
    }

    function hidePlayBtn(btnWrap) {
      if (!btnWrap) return;
      btnWrap.classList.add('is-hidden');
    }

    // ── Main update ────────────────────────────────────────
    function updateCarousel() {
      const frame2Idx = (currentIndex + 1) % totalItems;
      const frame3Idx = (currentIndex + 2) % totalItems;

      // Desktop images
      doctorImages.forEach((img) => {
        const imgIdx = parseInt(img.dataset.index);
        const frame = parseInt(img.dataset.frame);
        const show =
          (frame === 1 && imgIdx === currentIndex) ||
          (frame === 2 && imgIdx === frame2Idx) ||
          (frame === 3 && imgIdx === frame3Idx);
        img.style.opacity = show ? '1' : '0';
      });

      // Mobile images
      doctorImagesMobile.forEach((img) => {
        img.style.opacity = parseInt(img.dataset.index) === currentIndex ? '1' : '0';
      });

      // Testimonial items (desktop + mobile)
      [testimonialItems, testimonialItemsMobile].forEach((list) => {
        list.forEach((item) => {
          const active = parseInt(item.dataset.index) === currentIndex;
          item.classList.toggle('hidden', !active);
          item.style.opacity = active ? '1' : '0';
        });
      });

      // ── Play buttons ───────────────────────────────────────
      if (VIDEO_DISPLAY === 'active') {
        // Only frame 1 / mobile — show only if current block has video
        setPlayBtn(playBtns.frame1, currentIndex);
        setPlayBtn(playBtns.mobile, currentIndex);
        hidePlayBtn(playBtns.frame2);
        hidePlayBtn(playBtns.frame3);
      } else if (VIDEO_DISPLAY === 'all') {
        // Each frame independently checks its current block
        setPlayBtn(playBtns.frame1, currentIndex);
        setPlayBtn(playBtns.frame2, frame2Idx);
        setPlayBtn(playBtns.frame3, frame3Idx);
        setPlayBtn(playBtns.mobile, currentIndex);
      } else {
        // 'none' — hide all
        Object.values(playBtns).forEach(hidePlayBtn);
      }
    }

    function goNext() {
      currentIndex = (currentIndex + 1) % totalItems;
      updateCarousel();
    }
    function goPrev() {
      currentIndex = (currentIndex - 1 + totalItems) % totalItems;
      updateCarousel();
    }

    if (nextBtn) nextBtn.addEventListener('click', goPrev);
    if (prevBtn) prevBtn.addEventListener('click', goNext);
    if (nextBtnMobile) nextBtnMobile.addEventListener('click', goNext);
    if (prevBtnMobile) prevBtnMobile.addEventListener('click', goPrev);

    updateCarousel();
  })();
</script>

{% schema %}
{
  "name": "Doctor Carousel",
  "class": "section-doctor-testimonial-carousel",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p><strong>Prescribed By</strong> Doctors</p>"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "select",
      "id": "video_button_display",
      "label": "Show play button on",
      "options": [
        { "value": "active", "label": "Active slide only" },
        { "value": "all", "label": "All visible slides" },
        { "value": "none", "label": "Never" }
      ],
      "default": "all",
      "info": "Only shows if a video is set on that block. 'All visible slides' applies to all 3 frames on desktop."
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "inline_richtext",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button url"
