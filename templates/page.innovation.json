          }
        },
        "timeline_entry_UYrhw9": {
          "type": "timeline_entry",
          "settings": {
            "year": "Early 1990s",
            "pill": "The Insight",
            "title": "The plaster cast era had to end",
            "subtitle": "The spark that changed orthotics forever",
            "body": "<p>Dietmar Walter recognises that neither blueprint-based production nor plaster cast methods can scale in a modern economy. The idea for fully digital insole design takes shape — the same idea at the core of Stride Soles today.</p>",
            "featured": false,
            "show_cta": false,
            "cta_url": "",
            "cta_label": ""
          }
        },
        "timeline_entry_NdhjNE": {
          "type": "timeline_entry",
          "settings": {
            "year": "1982",
            "pill": "The Beginning",
            "title": "A master orthopaedic shoemaker qualifies",
            "subtitle": "The hands-on expertise that started it all",
            "body": "",
            "featured": false,
            "show_cta": false,
            "cta_url": "",
            "cta_label": ""
          }
        },
        "timeline_entry_aeMPgf": {
          "type": "timeline_entry",
          "settings": {
            "year": "1995",
            "pill": "Founding Milestone",
            "title": "pedcad founded — and wins Germany's Innovation Award",
            "subtitle": "The CAD/CAM system that powers every Stride Soles insole",
            "body": "<p>pedcad GmbH is established and immediately earns the Innovation Award of German Industry for its pioneering CAD/CAM system for designing and producing orthotics. That same technology sits at the heart of every pair of Stride Soles produced today.</p>",
            "featured": true,
            "show_cta": false,
            "cta_url": "",
            "cta_label": ""
          }
        },
        "timeline_entry_L3KD9m": {
          "type": "timeline_entry",
          "settings": {
            "year": "2000",
            "pill": "Optical Innovation",
            "title": "Light-stripe projection enters foot scanning",
            "subtitle": "The precursor to Stride's mobile 3D scanner",
            "body": "<p>In partnership with the Institute for Laser Technology in Ulm, pedcad integrates optical measurement into orthopaedic shoemaking, winning the Seifriz Award for science-craft collaboration. This directly informs the 3D mobile scanning used in Stride Soles assessments today.</p>",
            "featured": false,
            "show_cta": false,
            "cta_url": "",
            "cta_label": ""
          }
        },
        "timeline_entry_Y84xmx": {
          "type": "timeline_entry",
          "settings": {
            "year": "2005",
            "pill": "Clinical Depth",
            "title": "Podiatry credentials added to engineering expertise",
            "subtitle": "Technology meets genuine clinical understanding",
            "body": "<p>Dietmar Walter qualifies as a state-certified podiatrist, ensuring every digital system pedcad builds — and every Stride Soles prescription — is grounded in real clinical knowledge, not just manufacturing.</p>",
            "featured": false,
            "show_cta": false,
            "cta_url": "",
            "cta_label": ""
          }
        },
        "timeline_entry_qn4QLg": {
          "type": "timeline_entry",
          "settings": {
            "year": "2014",
            "pill": "Quality Standard",
            "title": "ISO 9001 certification",
            "subtitle": "Consistent quality on every single pair",
            "body": "<p>pedcad achieves ISO 9001:2008 certification, formalising the quality management standards that underpin every insole shipped under the Stride Soles name. The same certified process, every time.</p>",
            "featured": false,
            "show_cta": false,
            "cta_url": "",
            "cta_label": ""
          }
        },
        "timeline_entry_g8i4w8": {
          "type": "timeline_entry",
          "settings": {
            "year": "2016–2020",
            "pill": "Digital Platform",
            "title": "InsoleDesigner software matures",
            "subtitle": "From scan to finished insole — seamlessly",
            "body": "<p>Major updates to pedcad's InsoleDesigner construction platform and order management software create the seamless digital pipeline that makes Stride Soles' 15–20 day delivery possible at scale.</p>",
            "featured": false,
            "show_cta": false,
            "cta_url": "",
            "cta_label": ""
          }
        },
        "timeline_entry_aDjK7m": {
          "type": "timeline_entry",
          "settings": {
            "year": "Early 2020s",
            "pill": "Mobile Scanning",
            "title": "3D foot scanning moves to your phone",
            "subtitle": "Clinic-level precision from your living room",
            "body": "<p>PedCad partners with Dr. Zac Cartun, MD and Greg Gerla, two US based entreprenours. Together they launch Stride mobile, using the depth sensor in modern smartphones to capture precise 3D foot geometry anywhere. </p>",
            "featured": false,
            "show_cta": false,
            "cta_url": "",
            "cta_label": ""
          }
        },
        "timeline_entry_EFQki7": {
          "type": "timeline_entry",
          "settings": {
            "year": "Today",
            "pill": "Stride Soles",
            "title": "30 years of science, delivered to your door for $249",
            "subtitle": "The best orthotics in the world — in only a few minutes",
            "body": "<p>Stride Soles brings together pedcad's three decades of certified podiatric technology, German-designed prescription protocols, and mobile 3D scanning into one seamless experience. Scan your feet, receive clinician-designed custom orthotics in 15–20 days.</p>",
            "featured": true,
            "show_cta": false,
            "cta_url": "",
            "cta_label": ""
          }
        }
