      "blocks": {
        "timeline_entry_T83rTz": {
          "type": "timeline_entry",
          "settings": {
            "year": "1982",
            "pill": "The Beginning",
            "title": "A master orthopaedic shoemaker qualifies",
            "subtitle": "The hands-on expertise that started it all",
            "body": "<p>Dietmar Walter earns his certified master orthopaedic shoemaker qualification in Germany, building the hands-on clinical knowledge that would eventually power Stride Soles' entire prescription system.</p>",
            "featured": false,
            "show_cta": false,
            "cta_url": "",
